# BasicEmailSendingFlow

main: kit: flow: BasicEmailSendingFlow:
{
  entity: "email_sending",
  kind: "basic",
  name: "BasicEmailSendingFlow",
  step: [
    {
      i: {
        ref: "email_sending_ref01"
      }

      m: {
        account_id: "account01"
      }

      o: "create"
    }

    {
      i: {
        ref: "email_sending_ref01",
        srcdatavar: "email_sending_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "email_sending01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-email_sending_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEmailSendingFlow"
}