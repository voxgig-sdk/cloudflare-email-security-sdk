# BasicEmailSecurityFlow

main: kit: flow: BasicEmailSecurityFlow:
{
  entity: "email_security",
  kind: "basic",
  name: "BasicEmailSecurityFlow",
  step: [
    {
      i: {
        ref: "email_security_ref01"
      }

      m: {
        account_id: "account01",
        bulk_id: "bulk01",
        investigate_id: "investigate01"
      }

      o: "create"
    }

    {
      m: {
        account_id: "account01",
        investigate_id: "investigate01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "email_security_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "email_security_ref01",
        srcdatavar: "email_security_ref01_data",
        suffix: "_dt0"
      }

      m: {
        account_id: "account01",
        id: "email_security01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-email_security_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "email_security_ref01",
        suffix: "_rm0"
      }

      m: {
        account_id: "account01",
        id: "email_security01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        account_id: "account01",
        investigate_id: "investigate01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "email_security_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicEmailSecurityFlow"
}