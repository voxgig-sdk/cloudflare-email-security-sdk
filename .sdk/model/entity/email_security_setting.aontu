      sh: "Optional note describing the reason for the ignore pattern."
      t: "`$STRING`"
    }
    deletes: {
      h: "Deletes"
      n: "deletes"
      r: true
      sh: "IDs of the allow policies to delete."
      t: "`$ARRAY`"
    }
    domain: {
      h: "Domain"
      n: "domain"
      r: true
      sh: "The email domain to protect."
      t: "`$STRING`"
    }
    drop_dispositions: {
      h: "Drop Dispositions"
      n: "drop_dispositions"
