      h: "Require Tls Inbound"
      n: "require_tls_inbound"
      r: false
      sh: "Require TLS on inbound connections."
      t: "`$BOOLEAN`"
    }
    require_tls_outbound: {
      h: "Require Tls Outbound"
      n: "require_tls_outbound"
      r: false
      sh: "Require TLS on outbound connections."
      t: "`$BOOLEAN`"
    }
    result: {
      h: "Result"
      n: "result"
      op: {
        load: {
          req: true
          type: "`$OBJECT`"
        }
      }
      r: false
      sh: "An impersonation registry entry."
