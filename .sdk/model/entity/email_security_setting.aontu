        patch: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "Dispositions to drop instead of delivering, e.g."
      t: "`$ARRAY`"
    }
    folder: {
      h: "Folder"
      n: "folder"
      r: false
      sh: "The mailbox folder to scan, for API-scanning domains."
      t: "`$ANY`"
    }
    integration_id: {
      fo: "uuid"
      h: "Integration Id"
      n: "integration_id"
      r: false
      sh: "Identifier of the CASB integration that authorizes this domain."
      t: "`$STRING`"
    }
    ip_restrictions: {
      h: "Ip Restrictions"
      n: "ip_restrictions"
      op: {
        patch: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "Source IP ranges mail is accepted from."
      t: "`$ARRAY`"
    }
    lookback_hops: {
      h: "Lookback Hops"
      n: "lookback_hops"
      r: false
      sh: "Number of hops to trace back through received headers when reconstructing the original message (1-20)."
      t: "`$INTEGER`"
    }
    patches: {
      h: "Patches"
      n: "patches"
      r: true
      sh: "Partial updates to apply — each entry carries the policy's ID and only the fields to change."
      t: "`$ARRAY`"
    }
    pattern: {
      h: "Pattern"
      n: "pattern"
      op: {
        patch: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Regular expression identifying URLs to exempt from rewriting."
      t: "`$STRING`"
    }
    posts: {
      h: "Posts"
      n: "posts"
      r: true
      sh: "Allow policies to create."
      t: "`$ARRAY`"
    }
    puts: {
      h: "Puts"
      n: "puts"
      r: true
      sh: "Full replacements to apply — each entry carries the policy's ID and every field of its new value."
      t: "`$ARRAY`"
    }
    regions: {
      h: "Regions"
      n: "regions"
      op: {
        patch: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
