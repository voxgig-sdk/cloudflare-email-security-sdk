# Entity: email_security_setting

main: kit: entity: email_security_setting: {

  alias: field: {}

  fields: {
    allowed_delivery_modes: {
      h: "Allowed Delivery Modes"
      n: "allowed_delivery_modes"
      op: {
        patch: {
          req: false
          type: "`$ARRAY`"
        }
      }
      r: true
      sh: "Delivery modes to onboard the domain through."
